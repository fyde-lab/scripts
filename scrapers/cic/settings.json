{
  "name": "CIC",
  "short_description": "Opérations bancaires CIC",
  "description": "Se connecte à l'espace client CIC (cic.fr), avec la validation dans l'application si demandée, pour récupérer l'export des opérations bancaires.",
  "homepage": "https://www.cic.fr",
  "wreq_emulation": true,
  "debug_http_dump": false,
  "follow_redirects": true,
  "allowed_domains": [
    "cic.fr"
  ],
  "parameters": {
    "username": {
      "label": "Identifiant",
      "placeholder": "1234567890",
      "type": "string",
      "required": true
    },
    "password": {
      "label": "Mot de passe",
      "placeholder": "••••••••",
      "type": "string",
      "required": true,
      "secret": true
    },
    "language": {
      "label": "Langue du site (fr, en...)",
      "placeholder": "fr",
      "type": "string",
      "required": false
    }
  }
}
