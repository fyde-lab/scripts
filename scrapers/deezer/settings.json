{
  "name": "Deezer",
  "short_description": "Reçus d'abonnement Deezer",
  "description": "Se connecte au compte Deezer (deezer.com) pour récupérer les reçus de paiement de l'abonnement.",
  "homepage": "https://www.deezer.com",
  "wreq_emulation": true,
  "debug_http_dump": false,
  "follow_redirects": true,
  "allowed_domains": [
    "deezer.com",
    "dzcdn.net",
    "google.com",
    "gstatic.com",
    "recaptcha.net"
  ],
  "parameters": {
    "username": {
      "label": "Identifiant",
      "placeholder": "email@example.com",
      "type": "string",
      "required": true
    },
    "password": {
      "label": "Mot de passe",
      "placeholder": "••••••••",
      "type": "string",
      "required": true,
      "secret": true
    }
  }
}
