{
  "name": "Unibet",
  "short_description": "Dépôts Unibet",
  "description": "Se connecte au compte Unibet (unibet.fr) et enregistre un justificatif par dépôt.",
  "homepage": "https://www.unibet.fr",
  "wreq_emulation": true,
  "debug_http_dump": false,
  "follow_redirects": true,
  "allowed_domains": [
    "unibet.fr"
  ],
  "parameters": {
    "username": {
      "label": "Identifiant",
      "placeholder": "pseudo",
      "type": "string",
      "required": true
    },
    "password": {
      "label": "Mot de passe",
      "placeholder": "••••••••",
      "type": "string",
      "required": true,
      "secret": true
    },
    "dob": {
      "label": "Date de naissance (AAAA-MM-JJ)",
      "placeholder": "1980-01-31",
      "type": "string",
      "required": true
    }
  }
}
