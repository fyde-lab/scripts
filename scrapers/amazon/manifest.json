{
  "name": "Amazon",
  "short_description": "Factures Amazon.fr",
  "description": "Se connecte au compte Amazon.fr (avec le code de vérification si demandé) pour récupérer les factures des commandes.",
  "homepage": "https://www.amazon.fr",
  "wreq_emulation": true,
  "debug_http_dump": false,
  "follow_redirects": true,
