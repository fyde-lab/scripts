  "parameters": {
    "appKey": {
      "label": "Application key",
      "placeholder": "abcdef0123456789",
      "type": "string",
      "required": true
    },
    "appSecret": {
      "label": "Application secret",
      "placeholder": "••••••••",
      "type": "string",
      "required": true,
      "secret": true
    },
    "consumerKey": {
      "label": "Consumer key",
      "placeholder": "••••••••",
      "type": "string",
      "required": true,
      "secret": true
    },
    "provider": {
      "label": "Point d'accès (ovh-eu, ovh-ca, kimsufi-eu...)",
      "placeholder": "ovh-eu",
      "type": "string",
      "required": false
    }
  },
  "status": {
