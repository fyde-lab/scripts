{
  "name": "OVHcloud",
  "short_description": "Factures OVHcloud (API)",
  "description": "Récupère les factures OVHcloud (ou Kimsufi / So you Start) via l'API OVH, avec des identifiants d'application.",
  "homepage": "https://www.ovhcloud.com",
  "wreq_emulation": true,
  "debug_http_dump": false,
  "follow_redirects": true,
  "allowed_domains": [
    "api.ovh.com",
    "ovh.com",
